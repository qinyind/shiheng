{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": ["apps/*", "packages/domain"],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:expo": "npm run start --workspace @diet/expo",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:domain && node --test tests/rendered-html.test.mjs",
    "test:domain": "node --test --experimental-test-coverage \"packages/domain/src/**/*.test.ts\"",
    "test:expo": "npm run typecheck --workspace @diet/expo",
    "test:server": "npm --prefix services/server test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern apps/native/capacitor-shell --ignore-pattern apps/native/ios/App/App/public --ignore-pattern apps/expo",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "ios:open": "open apps/native/ios/App/App.xcodeproj"
  },
  "overrides": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "^16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
