{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": ["apps/*", "packages/domain"],
  "scripts": {
    "dev": "npm run dev:expo",
    "dev:expo": "npm run start --workspace @diet/expo",
    "build": "npm run build --workspace @diet/expo",
    "start": "npm run preview --workspace @diet/expo",
    "test": "npm run test:domain",
    "test:domain": "node --test --experimental-test-coverage \"packages/domain/src/**/*.test.ts\"",
    "test:expo": "npm run typecheck --workspace @diet/expo",
    "test:server": "npm --prefix services/server test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern apps/expo",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts"
  },
  "overrides": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.59.3"
  },
  "type": "module"
}
